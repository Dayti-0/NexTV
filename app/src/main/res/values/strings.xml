    <string name="settings_decoder_software">%1$s (logiciel)</string>
    <string name="settings_decoder_none">Aucun décodeur proposé par l’appareil</string>
    <string name="settings_decoder_help">OK pour changer de décodeur. Le décodeur choisi est essayé en premier, les autres servent de repli. Les infos de lecture (touche Info ou menu des chaînes) indiquent celui qui est utilisé.</string>
